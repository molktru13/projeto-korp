{
  "title": "Projeto Korp - Observabilidade",
  "uid": "korp-dashboard",
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 2,
  "panels": [
    {
      "id": 1,
      "title": "Status do Serviço",
      "type": "stat",
      "datasource": {
        "uid": "PBFA97CFB590B2093",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "service_up",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red"
                },
                "1": {
                  "text": "ONLINE",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Uptime",
      "type": "stat",
      "datasource": {
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "time() - process_start_time_seconds{job=\"projeto-korp\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Total de Requisições",
      "type": "stat",
      "datasource": {
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(http_requests_total) or vector(0)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requisições por Segundo",
      "type": "stat",
      "datasource": {
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(http_requests_total[1m])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Latencia P95",
      "type": "timeseries",
      "datasource": {
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le)) or vector(0)",
          "refId": "A",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Taxa de Erros",
      "type": "stat",
      "datasource": {
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) / sum(rate(http_requests_total[5m])) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Requisições em Tempo Real",
      "type": "timeseries",
      "datasource": {
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "http_requests_in_flight",
          "refId": "A"
        },
        {
          "datasource": {
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "sum(rate(http_requests_total[1m]))",
          "refId": "B",
          "legendFormat": "req/s"
        }
      ]
    }
  ]
}